diff --git a/intern/cycles/scene/objectgroup.h b/intern/cycles/scene/objectgroup.h
new file mode 100644
index 00000000000..969847c51a8
--- /dev/null
+++ b/intern/cycles/scene/objectgroup.h
@@ -0,0 +1,93 @@
+/* SPDX-FileCopyrightText: 2011-2022 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Object groups: a prototype instanced many times.
+ *
+ * A group is a piece of geometry that appears repeatedly under different world
+ * transforms -- a tree made of a trunk and many leaves, scattered across a
+ * forest. Today Cycles flattens that: N group instances holding M members each
+ * become N * M separate world-space Objects, so a thousand trees of a hundred
+ * thousand leaves is a hundred million Object records.
+ *
+ * Holding the structure instead costs N + M: one member record per prototype
+ * piece, one instance record per placement.
+ *
+ * Member transforms are GROUP-LOCAL. A member's world transform is
+ *
+ *   world = instance.tfm * member.local
+ *
+ * and it does not exist as stored data -- which is the entire point, since
+ * storing it is what costs N * M.
+ *
+ * Members are deliberately not Objects. An Object carries a world transform,
+ * a device index and a slot in every per-object device array, and materialising
+ * one per member would reintroduce the cost this exists to avoid. Members hold
+ * only what distinguishes one piece of the prototype from another. */
+
+#include "scene/geometry.h"
+
+#include "util/transform.h"
+#include "util/types.h"
+#include "util/vector.h"
+
+CCL_NAMESPACE_BEGIN
+
+/* Forward declared rather than included: scene.h includes this header, and
+ * object.h reaches scene.h, so including it here would be circular. */
+class Object;
+
+/* One piece of a prototype: a mesh placed somewhere inside the group. */
+struct ObjectGroupMember {
+  Geometry *geometry = nullptr;
+
+  /* Relative to the group origin, NOT to the world. */
+  Transform local = transform_identity();
+
+  /* The member's own ray visibility. Combined with the instance's, so a member
+   * can be hidden from camera rays inside a group that is not. */
+  uint visibility = ~0u;
+
+  bool is_shadow_catcher = false;
+
+  /* Object carrying this member's geometry, shader and attribute data. Never
+   * drawn directly; the kernel resolves prototype data through it. Its own
+   * transform is meaningless -- `local` above is the transform that matters. */
+  Object *prototype = nullptr;
+};
+
+/* A prototype. Referenced by many instances; never drawn on its own. */
+class ObjectGroup {
+ public:
+  vector<ObjectGroupMember> members;
+
+  /* Index in Scene::object_groups. Assigned during device update. */
+  int index = -1;
+};
+
+/* One placement of a group in the world.
+ *
+ * A plain struct, not a Node. There is one of these per visible instance --
+ * potentially millions -- so it must stay cheap to create and copy. Socket
+ * level dirty tracking would cost an allocation each, which defeats the
+ * purpose. */
+struct ObjectGroupInstance {
+  /* Index into Scene::object_groups. */
+  int group = -1;
+
+  /* World transform of the group origin. */
+  Transform tfm = transform_identity();
+
+  uint visibility = ~0u;
+
+  /* Seed for per-instance variation. Combined with a member index at shade
+   * time to give per-member randomness without storing N * M values. */
+  uint random_id = 0;
+
+  bool use_holdout = false;
+  bool is_shadow_catcher = false;
+};
+
+CCL_NAMESPACE_END

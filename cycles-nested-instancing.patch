+    set<Object *> to_delete;
+    for (size_t i = num_objects_needed; i < instance_set.objects.size(); i++) {
+      to_delete.insert(instance_set.objects[i]);
+    }
+    scene->delete_nodes(to_delete);
+    instance_set.objects.resize(num_objects_needed);
+  }
+
+  /* Prototype count shrank: free the tail, for the same reason.
+   *
+   * Prototypes are grown on demand and reused by index below, so without this a
+   * shrinking member count -- removing an object from an instanced collection,
+   * or regrowing a tree with fewer twigs -- leaves the prototypes past the new
+   * end alive in scene->objects. Nothing marks their geometry used this sync,
+   * so geometry_map.post_sync() frees it and the next device_update_transforms
+   * reads a destroyed Geometry through them. */

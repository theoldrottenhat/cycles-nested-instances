+  device_only_memory<char> temp_mem(this, "optix nested as temp", true);
+  temp_mem.alloc_to_device(sizes.tempSizeInBytes);
+  if (!temp_mem.device_pointer) {
+    return 0;
+  }
+
+  r_data = make_unique<device_only_memory<char>>(this, "optix nested as", false);
+  r_data->alloc_to_device(sizes.outputSizeInBytes);
+  if (!r_data->device_pointer) {
+    return 0;
+  }
+
+  OptixTraversableHandle handle = 0;
+  optix_assert(optixAccelBuild(context,
+                               nullptr,
+                               &options,
+                               &build_input,
+                               1,
+                               temp_mem.device_pointer,
+                               sizes.tempSizeInBytes,
+                               r_data->device_pointer,
+                               sizes.outputSizeInBytes,
+                               &handle,
+                               nullptr,
+                               0));
+  cuda_assert(cuStreamSynchronize(nullptr));
+
+  return handle;
+}

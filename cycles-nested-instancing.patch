diff --git a/source/blender/draw/intern/draw_context.cc b/source/blender/draw/intern/draw_context.cc
index d5b4a97f272..caf0d5810f3 100644
--- a/source/blender/draw/intern/draw_context.cc
+++ b/source/blender/draw/intern/draw_context.cc
@@ -1549,6 +1549,21 @@ static void drw_draw_render_loop_3d(DRWContext &draw_ctx, RenderEngineType *engi
                                 gpencil_engine_needed;
 
   auto should_draw_object = [&](Object &ob, bool /*has_duplis*/) -> DrawFilter {
+    /* "Render engine only" display (OB_HIDE_RASTERIZER): never add this object's
+     * geometry to the DRW (OpenGL/Vulkan) path in ANY viewport -- neither the
+     * rasterizer surface (Solid/Wireframe/Material Preview/EEVEE) nor the overlay
+     * pass. External render engines such as Cycles sync objects through their own
+     * depsgraph walk (not this predicate), so the object (and all its instances)
+     * still render and stay visible in a Cycles Rendered viewport.
+     *
+     * SkipRecursive is essential for the main use case -- an instancer producing
+     * huge numbers of duplis: it culls the ENTIRE dupli set in one decision, so
+     * object_duplilist() is never called and none of the (potentially millions
+     * of) instances are generated or drawn by the rasterizer. On a plain object
+     * with no duplis this is equivalent to Skip. Select it via the Outliner. */
+    if (ob.visibility_flag & OB_HIDE_RASTERIZER) {
+      return DrawFilter::SkipRecursive;
+    }
     return BKE_object_is_visible_in_viewport(v3d, &ob) ? DrawFilter::Draw : DrawFilter::Skip;
   };
 

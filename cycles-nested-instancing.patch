diff --git a/intern/cycles/util/update_timing.h b/intern/cycles/util/update_timing.h
new file mode 100644
index 00000000000..14c489a4b73
--- /dev/null
+++ b/intern/cycles/util/update_timing.h
@@ -0,0 +1,126 @@
+/* SPDX-FileCopyrightText: 2011-2022 Blender Foundation
+ *
+ * SPDX-License-Identifier: Apache-2.0 */
+
+#pragma once
+
+/* Scene update timing instrumentation.
+ *
+ * Temporary measurement scaffolding for the cycles-incremental-updates branch.
+ * Cycles' own SceneUpdateStats is only enabled for background F12 renders
+ * (blender/session.cpp), so it cannot see the interactive viewport path, which
+ * is exactly the path we need to profile.
+ *
+ * Disabled unless CYCLES_UPDATE_TIMING is set to a writable file path, e.g.
+ *
+ *   set CYCLES_UPDATE_TIMING=D:\tmp\cycles_timing.log
+ *
+ * When unset, update_timing_file() returns null on the first call and every
+ * macro below compiles down to a null check, so there is no measurable cost.
+ *
+ * Remove before this branch is considered for upstream. */
+
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+
+#include "util/thread.h"
+#include "util/time.h"
+
+CCL_NAMESPACE_BEGIN
+
+inline thread_mutex &update_timing_mutex()
+{
+  static thread_mutex mutex;
+  return mutex;
+}
+
+inline FILE *update_timing_file()
+{
+  static FILE *file = []() -> FILE * {
+    const char *path = getenv("CYCLES_UPDATE_TIMING");
+    if (path == nullptr || path[0] == '\0') {
+      return nullptr;
+    }
+    FILE *f = fopen(path, "a");
+    if (f != nullptr) {
+      fprintf(f, "\n=== cycles update timing session start ===\n");
+      fflush(f);
+    }
+    return f;
+  }();
+  return file;
+}
+
+inline bool update_timing_enabled()
+{
+  return update_timing_file() != nullptr;
+}
+
+/* Monotonically increasing id so lines belonging to one viewport update can be
+ * grouped together when reading the log. */
+inline int update_timing_event_id(const bool advance = false)
+{
+  static int id = 0;
+  if (advance) {
+    id++;
+  }
+  return id;
+}
+
+inline void update_timing_log(const char *fmt, ...)
+{
+  FILE *file = update_timing_file();
+  if (file == nullptr) {
+    return;
+  }
+  const thread_scoped_lock lock(update_timing_mutex());
+  fprintf(file, "[%04d] ", update_timing_event_id());
+  va_list args;
+  va_start(args, fmt);
+  vfprintf(file, fmt, args);
+  va_end(args);
+  fputc('\n', file);
+  fflush(file);
+}
+
+/* Write text verbatim. Use this for multi-line reports, which may contain '%'
+ * and must not go through a format string. */
+inline void update_timing_write(const char *text)
+{
+  FILE *file = update_timing_file();
+  if (file == nullptr) {
+    return;
+  }
+  const thread_scoped_lock lock(update_timing_mutex());
+  fprintf(file, "[%04d] ---- manager report ----\n%s\n", update_timing_event_id(), text);
+  fflush(file);
+}
+
+/* Times its own lifetime and logs "<label>: N.NN ms" when it goes out of
+ * scope. Constructing one when timing is disabled does nothing. */
+class UpdateScopedTimer {
+ public:
+  explicit UpdateScopedTimer(const char *label) : label_(label)
+  {
+    if (update_timing_enabled()) {
+      start_ = time_dt();
+    }
+  }
+
+  ~UpdateScopedTimer()
+  {
+    if (start_ != 0.0) {
+      update_timing_log("%-44s %8.2f ms", label_, (time_dt() - start_) * 1000.0);
+    }
+  }
+
+  UpdateScopedTimer(const UpdateScopedTimer &) = delete;
+  UpdateScopedTimer &operator=(const UpdateScopedTimer &) = delete;
+
+ private:
+  const char *label_;
+  double start_ = 0.0;
+};
+
+CCL_NAMESPACE_END
